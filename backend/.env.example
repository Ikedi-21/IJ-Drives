# Application
PROJECT_NAME="IJDrives API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security (Change in production!)
SECRET_KEY="ijdrives-insecure-secret-key-change-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: async SQLite database in backend directory
DATABASE_URL="sqlite+aiosqlite:///./ijdrives.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ijdrives"

# CORS (Frontend origins allowed to connect)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8000","http://127.0.0.1:8000","*"]

# Business Rules
WELCOME_BONUS_NGN=500.00
MIN_DEPOSIT_NGN=500.00
MAX_DEPOSIT_NGN=500000.00
